# ==============================================================
# OpenAksara Environment Configuration Template
# ==============================================================
# CARA PAKAI:
# 1. Salin file ini dan ubah namanya menjadi ".env"
# 2. Isi nilai kredensial di bawah ini.
# 3. File ".env" sudah otomatis diabaikan oleh .gitignore!
# ==============================================================

PORT=3000

# Firebase Cloud Firestore Credentials
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Telegram Bot Alert (Opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
